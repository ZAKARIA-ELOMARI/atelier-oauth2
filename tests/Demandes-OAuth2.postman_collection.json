          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"EN_ATTENTE\", () => pm.expect(d.statut).to.eql(\"EN_ATTENTE\"));",
                  "pm.collectionVariables.set(\"demandeId\", d.id);"
                ]
